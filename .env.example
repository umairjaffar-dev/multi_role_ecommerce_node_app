# ── App ──
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173
LOG_LEVEL=debug

# ── Database ──
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce_db
DB_POOL_MAX=10

# ── JWT ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
