# ── App ──
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173
LOG_LEVEL=debug

# ── Database ──
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce_db
DB_POOL_MAX=10

# ── JWT ──
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

# ── Refresh token ──
REFRESH_TOKEN_TTL_DAYS=1


# ── Security ──
BCRYPT_SALT_ROUNDS=12

# ── Object storage (S3 API) ──
# Development: SeaweedFS in Docker. Production: leave S3_ENDPOINT empty to use real AWS S3
S3_ENDPOINT=http://localhost:8333
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
S3_BUCKET=ecommerce_images
S3_ACCESS_KEY_ID=devkey
S3_SECRET_ACCESS_KEY=devsecret12345
S3_PUBLIC_BASE_URL=